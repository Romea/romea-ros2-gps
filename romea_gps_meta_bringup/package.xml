<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>romea_gps_meta_bringup</name>
  <version>0.0.0</version>
  <description>Package containing gps launch files.</description>

  <maintainer email="jean.laneurit@inrae.fr">Jean Laneurit</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>romea_common_meta_bringup</depend>
  <depend>romea_gps_description</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- <exec_depend>romea_ublox_driver</exec_depend> -->
  <!-- <exec_depend>nmea_navsat_driver</exec_depend> -->
  <exec_depend>ntrip_client</exec_depend>

  <exec_depend>romea_simulation_meta_bringup</exec_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>nmea_msgs</test_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend condition="$ROS_DISTRO &lt;= iron">romea_gps_gazebo_classic</exec_depend>
  <exec_depend condition="$ROS_DISTRO &gt; iron">romea_gps_gazebo</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>